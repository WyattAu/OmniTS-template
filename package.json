{
  "name": "omnits-template",
  "private": true,
  "type": "module",
  "packageManager": "bun",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "bun run --filter '@omni/web' e2e",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "6.0.3",
    "knip": "^6.39.0",
    "@changesets/cli": "^2.27.0",
    "@changesets/changelog-github": "^0.5.0"
  }
}
