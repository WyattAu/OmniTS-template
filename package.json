{
  "name": "omnits-template",
  "private": true,
  "type": "module",
  "packageManager": "bun",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "bun run --filter '@omni/web' e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.6.0",
    "knip": "^5.0.0",
    "@changesets/cli": "^3.0.3"
  }
}
